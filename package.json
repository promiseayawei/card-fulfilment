{
  "name": "card-packaging",
  "private": true,
  "version": "0.0.0",
  "description": "Kegow card fulfilment and activation guide printer",
  "author": "promiseayawei",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "decrypt": "node scripts/decrypt.mjs",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.enetworkspay.kegow.card-fulfilment",
    "productName": "Kegow Card Fulfilment",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "mac": { "target": [{ "target": "dir", "arch": ["universal"] }] },
    "win": { "target": "dir" },
    "linux": { "target": "dir" }
  },
  "dependencies": {
    "office-crypto": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wait-on": "^9.1.0"
  }
}
